---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Rainy Band - Acoustic & Vocal" } = Astro.props;
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Rainy Band cung cấp ban nhạc acoustic, vocal và nhạc công chuyên nghiệp." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-neutral-bg text-neutral-text font-sans antialiased">
		<slot />
	</body>
</html>
