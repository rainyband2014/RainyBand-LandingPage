import Hero from '../components/home/Hero.astro';
import Showreel from '../components/home/Showreel.astro';
import InfoStrip from '../components/home/InfoStrip.astro';
import ClientLogos from '../components/home/ClientLogos.astro';
import CoreTeamSection from '../components/home/CoreTeamSection.astro';
