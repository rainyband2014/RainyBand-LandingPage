---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/shared/Container.astro';
import Badge from '../../components/shared/Badge.astro';
import BookingForm from '../../components/home/BookingForm';

const socialLinks = [
  { label: 'YouTube', href: '#' },
  { label: 'TikTok', href: '#' },
  { label: 'Facebook', href: '#' },
  { label: 'Instagram', href: '#' },
];

const contactChecklist = [
  "Ngày và giờ tổ chức",
  "Địa điểm biểu diễn",
  "Loại hình sự kiện",
  "Số lượng khách mời",
  "Đội hình mong muốn",
  "Phong cách âm nhạc",
  "Thời lượng biểu diễn",
  "Yêu cầu đặc biệt của chương trình"
];
---

<PageLayout
  title="Liên hệ | Rainy Band"
  description="Liên hệ Rainy Band để đặt lịch biểu diễn, tư vấn gói dịch vụ âm nhạc cho sự kiện của bạn. Hotline, Zalo và form đặt lịch nhanh."
>
  <section class="w-full pt-16 pb-12 md:pt-24 md:pb-16 bg-neutral-bg">
    <Container>
      <div class="reveal">
        <Badge label="LIÊN HỆ" tone="dark" class="mb-4" />
      </div>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-display font-bold text-brand-900 tracking-tight mb-6 reveal" data-delay="100">
        Liên hệ Rainy Band
      </h1>
      <p class="text-base md:text-xl text-neutral-muted leading-relaxed max-w-3xl reveal" data-delay="200">
        Để được tư vấn về đội hình, lịch biểu diễn và chi phí, vui lòng liên hệ trực tiếp với Rainy Band qua:
      </p>
    </Container>
  </section>

  <section class="w-full py-12 md:py-20 bg-neutral-bg">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">
        <!-- Left Column: Contact Info -->
        <div class="md:col-span-5 flex flex-col reveal">
          <div class="space-y-6">
            <div class="reveal" data-delay="100">
              <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Hotline</p>
              <a href="tel:0332552700" class="text-lg text-brand-900 font-medium hover:text-brand-600 transition-colors">
                0332 552 700
              </a>
            </div>
            <div class="reveal" data-delay="200">
              <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Fanpage</p>
              <!-- TODO: thay link Fanpage thật -->
              <a href="#" class="text-lg text-brand-900 font-medium hover:text-brand-600 transition-colors">
                Rainy Band
              </a>
            </div>
            <div class="reveal" data-delay="250">
              <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Hình thức liên hệ</p>
              <p class="text-base text-neutral-text">Nhắn tin trực tiếp qua Fanpage hoặc gọi điện thoại.</p>
            </div>
            <div class="reveal" data-delay="300">
              <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Địa chỉ hoạt động</p>
              <p class="text-base text-neutral-text">TP. Hồ Chí Minh</p>
            </div>
          </div>

          <div class="mt-10 pt-8 border-t border-neutral-text/10 reveal" data-delay="350">
            <p class="text-sm text-neutral-muted leading-relaxed mb-4">
              Khi liên hệ, khách hàng có thể cung cấp trước các thông tin:
            </p>
            <ul class="space-y-2 mb-6">
              {contactChecklist.map(item => (
                <li class="flex items-start gap-2 text-sm text-neutral-text">
                  <span class="text-brand-600 mt-0.5 flex-shrink-0">•</span>
                  {item}
                </li>
              ))}
            </ul>
            <p class="text-sm text-neutral-muted leading-relaxed">
              Rainy Band sẽ phản hồi và tư vấn phương án phù hợp trong thời gian sớm nhất.
            </p>
          </div>

          <div class="mt-10 pt-8 border-t border-neutral-text/10 reveal" data-delay="400">
            <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-4">Theo dõi Rainy Band</p>
            <!-- TODO: thay href thật cho social links -->
            <div class="flex flex-wrap gap-4">
              {socialLinks.map(link => (
                <a href={link.href} class="text-sm font-medium text-neutral-muted hover:text-brand-600 transition-colors">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Right Column: Form -->
        <div class="md:col-span-7 reveal" data-delay="200">
          <div class="bg-neutral-surface rounded-3xl p-6 md:p-8 lg:p-10 shadow-sm border border-neutral-text/5">
            <h2 class="text-xl font-display font-bold text-brand-900 mb-6">Gửi yêu cầu tư vấn</h2>
            <BookingForm client:visible />
          </div>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
