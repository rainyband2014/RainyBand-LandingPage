---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/shared/Container.astro';
import Badge from '../../components/shared/Badge.astro';
import { showcaseItems } from '../../data/showcaseItems';
---

<PageLayout
  title="Showcase | Rainy Band"
  description="Xem hình ảnh và video các buổi biểu diễn nổi bật của Rainy Band — từ sân khấu sự kiện doanh nghiệp đến tiệc cưới và quán café acoustic."
>
  <section class="w-full pt-16 pb-12 md:pt-24 md:pb-16 bg-neutral-bg reveal">
    <Container>
      <Badge label="SHOWCASE" tone="dark" class="mb-4" />
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-display font-bold text-brand-900 tracking-tight mb-6">
        Media của Rainy Band
      </h1>
      <p class="text-base md:text-xl text-neutral-muted leading-relaxed max-w-3xl">
        Hình ảnh và video từ các buổi biểu diễn, sự kiện và hậu trường của Rainy Band.
      </p>
    </Container>
  </section>

  <!-- TODO: thêm lightbox hoặc trang chi tiết media khi có nội dung thật -->
  <section class="w-full py-12 md:py-20 bg-neutral-bg">
    <Container>
      <!-- Filter Tabs: Type -->
      <p class="text-xs font-bold tracking-wider uppercase text-neutral-muted/70 mb-2">Loại nội dung</p>
      <div class="flex flex-wrap items-center gap-3 mb-6 pb-6 border-b border-neutral-text/10" id="showcase-filters-type">
        <button 
          data-filter="all" 
          class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-brand-600 text-white"
        >
          Tất cả
        </button>
        <button 
          data-filter="image" 
          class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5"
        >
          Ảnh
        </button>
        <button 
          data-filter="video" 
          class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5"
        >
          Video
        </button>
      </div>

      <!-- Filter Tabs: Category -->
      <p class="text-xs font-bold tracking-wider uppercase text-neutral-muted/70 mb-2">Danh mục sự kiện</p>
      <div class="flex flex-wrap items-center gap-3 mb-10" id="showcase-filters-category">
        <button data-category="all" class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-brand-600 text-white">
          Tất cả
        </button>
        <button data-category="acoustic-live" class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5">
          Acoustic Live Session
        </button>
        <button data-category="electric-full-band" class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5">
          Electric Full Band
        </button>
        <button data-category="nhac-viet" class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5">
          Nhạc Việt
        </button>
        <button data-category="nhac-quoc-te" class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5">
          Nhạc quốc tế
        </button>
        <button data-category="wedding" class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5">
          Wedding Performance
        </button>
        <button data-category="corporate" class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5">
          Corporate Event
        </button>
        <button data-category="private-party" class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5">
          Private Party
        </button>
        <button data-category="cafe-acoustic" class="px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5">
          Cafe Acoustic
        </button>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5" id="showcase-grid">
        {showcaseItems.map((item, index) => (
          <div class="showcase-item relative aspect-[4/5] rounded-2xl overflow-hidden group cursor-pointer shadow-sm hover-media-container reveal" data-type={item.type} data-category={item.category} data-delay={Math.min(index * 50, 500)}>
            <!-- TODO: thay bằng ảnh/video thật -->
            <img 
              src={item.thumbnailUrl} 
              alt={item.title}
              title={item.title}
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="hover-media-overlay z-10"></div>

            {item.type === 'video' && (
              <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none">
                <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/40 shadow-sm group-hover:scale-110 transition-transform duration-300">
                  <span class="text-white text-xl ml-1 leading-none">▸</span>
                </div>
              </div>
            )}
            
            <div class="absolute bottom-4 left-4 right-4 z-20 opacity-0 transform translate-y-4 transition-all duration-400 group-hover:opacity-100 group-hover:translate-y-0">
              <span class="bg-black/60 text-white text-xs font-medium px-3 py-1.5 rounded-full backdrop-blur-sm">
                {item.title}
              </span>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>
</PageLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const typeFilters = document.querySelectorAll('#showcase-filters-type button');
    const categoryFilters = document.querySelectorAll('#showcase-filters-category button');
    const items = document.querySelectorAll('.showcase-item');

    let currentType = 'all';
    let currentCategory = 'all';

    function updateItems() {
      items.forEach(item => {
        const itemType = item.getAttribute('data-type');
        const itemCategory = item.getAttribute('data-category');
        
        const typeMatch = currentType === 'all' || itemType === currentType;
        const categoryMatch = currentCategory === 'all' || itemCategory === currentCategory;

        if (typeMatch && categoryMatch) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    }

    function setActiveBtn(buttons: NodeListOf<Element>, activeBtn: Element) {
      buttons.forEach(btn => {
        if (btn === activeBtn) {
          btn.className = "px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-brand-600 text-white";
        } else {
          btn.className = "px-5 py-2 rounded-full text-sm font-bold tracking-wider uppercase transition-colors bg-neutral-surface border border-neutral-text/10 text-neutral-text hover:bg-neutral-text/5";
        }
      });
    }

    typeFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        currentType = btn.getAttribute('data-filter') || 'all';
        setActiveBtn(typeFilters, btn);
        updateItems();
      });
    });

    categoryFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'all';
        setActiveBtn(categoryFilters, btn);
        updateItems();
      });
    });
  });
</script>