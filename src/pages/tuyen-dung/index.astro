---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/shared/Container.astro';
import Badge from '../../components/shared/Badge.astro';
import Button from '../../components/shared/Button.astro';
import { recruitment } from '../../data/recruitment';

const { contact } = recruitment;
const mailtoHref = `mailto:${contact.email}?subject=${encodeURIComponent(contact.emailSubjectTemplate)}`;
const telHref = `tel:${contact.hotlinePhone}`;
---

<PageLayout
  title="Tuyển dụng thành viên | Rainy Band"
  description="Rainy Band tuyển ca sĩ và nhạc công có kinh nghiệm biểu diễn, đam mê âm nhạc, mong muốn phát triển lâu dài trong môi trường chuyên nghiệp. Ứng tuyển ngay."
>
  <!-- Hero -->
  <section class="w-full pt-16 pb-12 md:pt-24 md:pb-16 bg-neutral-bg">
    <Container>
      <div class="reveal">
        <Badge label={recruitment.badge} tone="dark" class="mb-4" />
      </div>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-display font-bold text-brand-900 tracking-tight mb-4 reveal" data-delay="100">
        {recruitment.title}
      </h1>
      <p class="text-lg md:text-2xl font-medium text-brand-600 mb-6 reveal" data-delay="150">
        {recruitment.subtitle}
      </p>
      <p class="text-base md:text-xl text-neutral-muted leading-relaxed max-w-3xl reveal" data-delay="200">
        {recruitment.intro}
      </p>
    </Container>
  </section>

  <!-- Hero image -->
  <section class="w-full bg-neutral-bg pb-12 md:pb-16">
    <Container>
      <div class="relative w-full aspect-video md:aspect-[21/9] rounded-3xl overflow-hidden shadow-md reveal" data-delay="250">
        <img
          src={recruitment.heroImageUrl}
          alt={recruitment.heroImageAlt}
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
    </Container>
  </section>

  <!-- Vị trí đang tuyển -->
  <section class="w-full py-12 md:py-16 bg-neutral-surface border-y border-neutral-text/10">
    <Container>
      <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-900 mb-6 tracking-tight reveal">
        Đang tìm kiếm các thành viên mới cho những vị trí
      </h2>
      <div class="flex flex-wrap gap-3 reveal" data-delay="100">
        {recruitment.positions.map(position => (
          <span class="px-4 py-2 bg-white rounded-full text-sm md:text-base font-medium text-neutral-text border border-neutral-text/10 shadow-sm">
            {position}
          </span>
        ))}
      </div>
    </Container>
  </section>

  <!-- Nội dung dạng blog: xen kẽ đoạn văn / danh sách / hình ảnh -->
  <section class="w-full py-12 md:py-20 bg-neutral-bg">
    <Container>
      <div class="max-w-3xl mx-auto flex flex-col gap-10 md:gap-14">
        {recruitment.content.map((block) => {
          if (block.type === 'image') {
            return (
              <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-md reveal not-prose -mx-4 md:mx-0 md:w-[calc(100%+6rem)] md:-ml-12">
                <img
                  src={block.imageUrl}
                  alt={block.imageAlt || ''}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            );
          }

          if (block.type === 'list') {
            return (
              <div class="reveal">
                {block.heading && (
                  <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-900 mb-4 tracking-tight">
                    {block.heading}
                  </h2>
                )}
                {block.text && (
                  <p class="text-base md:text-lg text-neutral-text leading-relaxed mb-4">
                    {block.text}
                  </p>
                )}
                <ul class="list-disc pl-5 space-y-2 text-base md:text-lg text-neutral-text leading-relaxed marker:text-brand-600">
                  {block.items?.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            );
          }

          return (
            <div class="reveal">
              {block.heading && (
                <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-900 mb-4 tracking-tight">
                  {block.heading}
                </h2>
              )}
              {block.text && (
                <p class="text-base md:text-lg text-neutral-text leading-relaxed">
                  {block.text}
                </p>
              )}
            </div>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- Cách thức ứng tuyển / Liên hệ -->
  <section class="w-full py-12 md:py-20 bg-neutral-surface border-t border-neutral-text/10">
    <Container>
      <div class="max-w-3xl mx-auto">
        <div class="p-6 md:p-10 bg-white rounded-3xl border border-neutral-text/5 shadow-sm reveal">
          <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-6">
            Gửi hồ sơ ứng tuyển
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
            <div>
              <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Email</p>
              <a href={mailtoHref} class="text-lg text-brand-900 font-medium hover:text-brand-600 transition-colors break-all">
                {contact.email}
              </a>
            </div>
            <div>
              <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">{contact.hotlineLabel}</p>
              <a href={telHref} class="text-lg text-brand-900 font-medium hover:text-brand-600 transition-colors">
                {contact.hotlinePhone.replace(/(\d{4})(\d{3})(\d{3})/, '$1 $2 $3')}
              </a>
              <p class="text-sm text-neutral-muted mt-1">Người liên hệ: {contact.contactPerson}</p>
            </div>
          </div>

          <div class="p-4 bg-brand-50 rounded-xl mb-8">
            <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Tiêu đề email đề xuất</p>
            <p class="text-sm md:text-base text-neutral-text italic">{contact.emailSubjectTemplate}</p>
          </div>

          <div class="flex flex-wrap gap-4">
            <Button href={mailtoHref} variant="primary" size="md">
              Gửi email ứng tuyển
            </Button>
            <Button href={telHref} variant="outline" size="md">
              Liên hệ Zalo / Hotline
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Gia nhập Rainy Band -->
  <section class="w-full py-16 md:py-24 bg-neutral-bg">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-900 tracking-tight mb-4 reveal">
          {recruitment.closingTitle}
        </h2>
        <p class="text-base md:text-lg text-neutral-muted leading-relaxed mb-8 reveal" data-delay="100">
          {recruitment.closingText}
        </p>
        <div class="flex justify-center reveal" data-delay="200">
          <Button href={mailtoHref} variant="primary" size="lg">
            Ứng tuyển ngay
          </Button>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
