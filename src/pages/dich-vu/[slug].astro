---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/shared/Container.astro';
import Badge from '../../components/shared/Badge.astro';
import Button from '../../components/shared/Button.astro';
import { services } from '../../data/services';
import type { Service } from '../../data/services';

export const prerender = true;

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

if (!service) {
  return Astro.redirect('/404');
}

const descriptionParagraphs = service.longDescription.split('\n').filter((p: string) => p.trim() !== '');

const descPrefix = `Dịch vụ ${service.title} của Rainy Band. `;
let truncatedBio = service.longDescription;
const maxBioLength = 155 - descPrefix.length - 3;
if (truncatedBio.length > maxBioLength) {
  truncatedBio = truncatedBio.substring(0, maxBioLength);
  const lastSpace = truncatedBio.lastIndexOf(' ');
  if (lastSpace > 0) truncatedBio = truncatedBio.substring(0, lastSpace);
  truncatedBio += '...';
}
const pageDescription = descPrefix + truncatedBio;
---

<PageLayout
  title={`${service.title} | Rainy Band`}
  description={pageDescription}
>
  <section class="w-full py-16 md:py-24 bg-neutral-bg">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 lg:gap-16">
        <!-- Left Column: Image -->
        <div class="md:col-span-7 reveal">
          <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-md">
            <!-- TODO: thay bằng ảnh dịch vụ thật -->
            <img 
              src={service.imageUrl} 
              alt={service.title} 
              class="absolute inset-0 w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Right Column: Info -->
        <div class="md:col-span-5 flex flex-col">
          <div class="reveal" data-delay="100">
            <Badge label="DỊCH VỤ" tone="dark" class="mb-4 self-start" />
          </div>
          
          <h1 class="text-3xl md:text-4xl font-display font-bold text-brand-900 tracking-tight mb-6 reveal" data-delay="200">
            {service.title}
          </h1>

          <div class="space-y-4 mb-8 reveal" data-delay="300">
            {descriptionParagraphs.map((paragraph: string) => (
              <p class="text-base md:text-lg text-neutral-text leading-relaxed">
                {paragraph}
              </p>
            ))}
          </div>

          <div class="p-5 bg-neutral-surface rounded-2xl border border-neutral-text/5 mb-8 reveal" data-delay="400">
            <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Phù hợp với</p>
            <p class="text-base text-neutral-text font-medium">{service.suitableFor}</p>
          </div>

          <div class="reveal" data-delay="500">
            <Button href="/#booking" variant="primary" size="md">
              Đặt lịch dịch vụ này
            </Button>
          </div>
        </div>
      </div>

      <!-- Back link -->
      <div class="mt-16 pt-8 border-t border-neutral-text/10 reveal" data-delay="200">
        <a href="/dich-vu" class="text-sm font-medium text-neutral-muted hover:text-brand-600 transition-colors">
          &larr; Xem tất cả dịch vụ
        </a>
      </div>
    </Container>
  </section>
</PageLayout>
