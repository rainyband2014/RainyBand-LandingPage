---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/shared/Container.astro';
import Badge from '../../components/shared/Badge.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import { services } from '../../data/services';
---

<PageLayout
  title="Dịch vụ | Rainy Band"
  description="Các gói dịch vụ biểu diễn của Rainy Band — từ acoustic duo, full band đến âm thanh ánh sáng, phù hợp cho quán café, tiệc cưới và sự kiện doanh nghiệp."
>
  <section class="w-full pt-16 pb-12 md:pt-24 md:pb-16 bg-neutral-bg">
    <Container>
      <div class="reveal">
        <Badge label="DỊCH VỤ" tone="dark" class="mb-4" />
      </div>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-display font-bold text-brand-900 tracking-tight mb-6 reveal" data-delay="100">
        Dịch vụ của Rainy Band
      </h1>
      <p class="text-base md:text-xl text-neutral-muted leading-relaxed max-w-3xl reveal" data-delay="200">
        Từ biểu diễn acoustic tại quán đến trọn gói sự kiện lớn, Rainy Band cung cấp giải pháp âm nhạc linh hoạt và chuyên nghiệp.
      </p>
    </Container>
  </section>

  <section class="w-full py-12 md:py-20 bg-neutral-bg">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
        {services.map((service, index) => (
          <div class="reveal" data-delay={index * 100}>
            <ServiceCard {...service} />
          </div>
        ))}
      </div>
    </Container>
  </section>
</PageLayout>
