---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/shared/Container.astro';
import Badge from '../../components/shared/Badge.astro';
import VocalCard from '../../components/vocal/VocalCard.astro';
import { vocalists, vocalGroupIntros } from '../../data/vocalists';

const maleVocalists = vocalists.filter(v => v.gender === 'nam');
const femaleVocalists = vocalists.filter(v => v.gender === 'nu');
const maleIntro = vocalGroupIntros.find(g => g.gender === 'nam')!;
const femaleIntro = vocalGroupIntros.find(g => g.gender === 'nu')!;
---

<PageLayout
  title="Đội ngũ Vocal | Rainy Band"
  description="Khám phá đội ngũ vocal chuyên nghiệp của Rainy Band — đa dạng phong cách từ Ballad, Pop, R&B đến Jazz, phù hợp mọi loại hình sự kiện."
>
  <section class="w-full pt-16 pb-12 md:pt-24 md:pb-16 bg-neutral-bg">
    <Container>
      <div class="reveal">
        <Badge label="VOCAL" tone="dark" class="mb-4" />
      </div>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-display font-bold text-brand-900 tracking-tight mb-6 reveal" data-delay="100">
        Đội ngũ vocal Rainy Band
      </h1>
      <p class="text-base md:text-xl text-neutral-muted leading-relaxed max-w-3xl reveal" data-delay="200">
        Mỗi giọng hát mang một màu sắc riêng, phù hợp với từng loại sự kiện và không gian biểu diễn.
      </p>
    </Container>
  </section>

  <!-- Vocal Nam -->
  <section class="w-full py-12 md:py-20 bg-neutral-bg">
    <Container>
      <div class="mb-10 reveal">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-900 tracking-tight mb-4">
          {maleIntro.title}
        </h2>
        <p class="text-base md:text-lg text-neutral-muted leading-relaxed max-w-3xl">
          {maleIntro.intro}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 md:gap-8">
        {maleVocalists.map((vocalist, index) => (
          <div class="reveal" data-delay={Math.min(index * 100, 500)}>
            <VocalCard {...vocalist} />
          </div>
        ))}
      </div>

      <div class="mt-8 reveal" data-delay="300">
        <p class="text-sm md:text-base text-neutral-muted italic leading-relaxed max-w-3xl bg-neutral-surface rounded-2xl p-5 border border-neutral-text/5">
          {maleIntro.closingNote}
        </p>
      </div>
    </Container>
  </section>

  <!-- Vocal Nữ -->
  <section class="w-full py-12 md:py-20 bg-neutral-bg border-t border-neutral-text/10">
    <Container>
      <div class="mb-10 reveal">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-900 tracking-tight mb-4">
          {femaleIntro.title}
        </h2>
        <p class="text-base md:text-lg text-neutral-muted leading-relaxed max-w-3xl">
          {femaleIntro.intro}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
        {femaleVocalists.map((vocalist, index) => (
          <div class="reveal" data-delay={Math.min(index * 100, 500)}>
            <VocalCard {...vocalist} />
          </div>
        ))}
      </div>

      <div class="mt-8 reveal" data-delay="300">
        <p class="text-sm md:text-base text-neutral-muted italic leading-relaxed max-w-3xl bg-neutral-surface rounded-2xl p-5 border border-neutral-text/5">
          {femaleIntro.closingNote}
        </p>
      </div>
    </Container>
  </section>
</PageLayout>
