---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/shared/Container.astro';
import Badge from '../../components/shared/Badge.astro';
import Button from '../../components/shared/Button.astro';
import { vocalists } from '../../data/vocalists';
import type { Vocalist } from '../../data/vocalists';

export function getStaticPaths() {
  return vocalists.map((vocalist) => ({
    params: { slug: vocalist.slug },
    props: { vocalist },
  }));
}

interface Props {
  vocalist: Vocalist;
}

const { vocalist } = Astro.props;
const bioParagraphs = vocalist.fullBio.split('\n').filter((p: string) => p.trim() !== '');
---

<PageLayout title={`${vocalist.name} - ${vocalist.badgeLabel} | Rainy Band`}>
  <section class="w-full py-16 md:py-24 bg-neutral-bg">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 lg:gap-16">
        <!-- Left Column: Image -->
        <div class="md:col-span-5">
          <div class="relative w-full aspect-[3/4] rounded-3xl overflow-hidden shadow-md">
            <!-- TODO: thay bằng ảnh vocalist thật -->
            <img 
              src={vocalist.posterImageUrl} 
              alt={vocalist.name} 
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-x-0 bottom-0 h-[40%] bg-gradient-to-t from-brand-950/60 to-transparent"></div>
          </div>
        </div>

        <!-- Right Column: Info -->
        <div class="md:col-span-7 flex flex-col">
          <Badge label={vocalist.badgeLabel} tone="dark" class="mb-4 self-start" />
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-brand-900 tracking-tight mb-4">
            {vocalist.name}
          </h1>

          <p class="text-sm text-brand-600 font-bold mb-8">
            {vocalist.experienceYears} năm kinh nghiệm
          </p>

          <div class="space-y-4 mb-10">
            {bioParagraphs.map((paragraph: string) => (
              <p class="text-base md:text-lg text-neutral-text leading-relaxed">
                {paragraph}
              </p>
            ))}
          </div>

          <div class="space-y-6 mb-10 p-6 bg-neutral-surface rounded-2xl border border-neutral-text/5">
            <div>
              <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Show / format hợp</p>
              <p class="text-base text-neutral-text font-medium">{vocalist.formats}</p>
            </div>
            <div>
              <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Mood / vibe</p>
              <p class="text-base text-neutral-text font-medium">{vocalist.mood}</p>
            </div>
            <div>
              <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Thể loại / gu hát</p>
              <p class="text-base text-neutral-text font-medium">{vocalist.genres}</p>
            </div>
          </div>

          <Button href="/#booking" variant="primary" size="md">
            Đặt lịch có {vocalist.name}
          </Button>

          {vocalist.videos && vocalist.videos.length > 0 && (
            <div className="mt-12 pt-8 border-t border-neutral-text/10">
              <h3 className="text-xl font-display font-bold text-brand-900 mb-6">Video demo</h3>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {vocalist.videos.map(video => (
                  <div className="group cursor-pointer">
                    <div className="relative aspect-video rounded-xl overflow-hidden shadow-sm mb-3">
                      <!-- TODO: thêm click để xem video -->
                      <img src={video.thumbnailUrl} alt={video.title} className="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                      <div className="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                        <div className="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/40 shadow-sm">
                          <span className="text-white text-lg ml-1 leading-none">▸</span>
                        </div>
                      </div>
                    </div>
                    <p className="text-sm font-medium text-neutral-text line-clamp-2 group-hover:text-brand-600 transition-colors">
                      {video.title}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- Back link -->
      <div class="mt-16 pt-8 border-t border-neutral-text/10">
        <a href="/vocal" class="text-sm font-medium text-neutral-muted hover:text-brand-600 transition-colors">
          &larr; Xem tất cả vocal
        </a>
      </div>
    </Container>
  </section>
</PageLayout>
