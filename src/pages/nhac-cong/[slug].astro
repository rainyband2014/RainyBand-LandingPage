---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/shared/Container.astro';
import Badge from '../../components/shared/Badge.astro';
import Button from '../../components/shared/Button.astro';
import TypewriterText from '../../components/TypewriterText';
import { musicians, instrumentToneMap } from '../../data/musicians';
import type { Musician } from '../../data/musicians';

export const prerender = true;

export function getStaticPaths() {
  return musicians.map((musician) => ({
    params: { slug: musician.slug },
    props: { musician },
  }));
}

interface Props {
  musician: Musician;
}

const { musician } = Astro.props;

if (!musician) {
  return Astro.redirect('/404');
}

const bioParagraphs = musician.fullBio.split('\n').filter((p: string) => p.trim() !== '');

const descPrefix = `${musician.name} — ${musician.instrument}, ${musician.experienceYears} năm kinh nghiệm tại Rainy Band. `;
let truncatedBio = musician.fullBio;
const maxBioLength = 155 - descPrefix.length - 3;
if (truncatedBio.length > maxBioLength) {
  truncatedBio = truncatedBio.substring(0, maxBioLength);
  const lastSpace = truncatedBio.lastIndexOf(' ');
  if (lastSpace > 0) truncatedBio = truncatedBio.substring(0, lastSpace);
  truncatedBio += '...';
}
const pageDescription = descPrefix + truncatedBio;
---

<PageLayout
  title={`${musician.name} - ${musician.instrumentGroup} | Rainy Band`}
  description={pageDescription}
>
  <section class="w-full py-16 md:py-24 bg-neutral-bg">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 lg:gap-16">
        <!-- Left Column: Image -->
        <div class="md:col-span-5">
          <div class="relative w-full aspect-[3/4] rounded-3xl overflow-hidden shadow-md">
            <!-- TODO: thay bằng ảnh thật -->
            <img 
              src={musician.imageUrl} 
              alt={musician.name} 
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-brand-950/50 to-transparent"></div>
          </div>
        </div>

        <!-- Right Column: Info -->
        <div class="md:col-span-7 flex flex-col">
          <Badge label={musician.instrumentGroup} tone={instrumentToneMap[musician.instrumentGroup] ?? 'dark'} class="mb-4 self-start" />
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-brand-900 tracking-tight mb-4">
            {musician.name}
          </h1>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-neutral-muted mb-8">
            <span class="font-bold text-brand-600">{musician.experienceYears} năm kinh nghiệm</span>
            <span class="hidden sm:inline text-neutral-text/30">·</span>
            <span>{musician.instrument}</span>
          </div>

          <TypewriterText paragraphs={bioParagraphs} client:visible />

          <Button href="/#booking" variant="primary" size="md">
            Đặt lịch có {musician.name}
          </Button>

          {musician.videos && musician.videos.length > 0 && (
            <div class="mt-12 pt-8 border-t border-neutral-text/10">
              <h3 class="text-xl font-display font-bold text-brand-900 mb-6">Video demo</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {musician.videos.map(video => (
                  <div class="group cursor-pointer">
                    <div class="relative aspect-video rounded-xl overflow-hidden shadow-sm mb-3">
                      <!-- TODO: thêm click để xem video -->
                      <img src={video.thumbnailUrl} alt={video.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                      <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                        <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/40 shadow-sm">
                          <span class="text-white text-lg ml-1 leading-none">▸</span>
                        </div>
                      </div>
                    </div>
                    <p class="text-sm font-medium text-neutral-text line-clamp-2 group-hover:text-brand-600 transition-colors">
                      {video.title}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- Back link -->
      <div class="mt-16 pt-8 border-t border-neutral-text/10">
        <a href="/nhac-cong" class="text-sm font-medium text-neutral-muted hover:text-brand-600 transition-colors">
          &larr; Xem tất cả nhạc công
        </a>
      </div>
    </Container>
  </section>
</PageLayout>
