---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/shared/Container.astro';
import Badge from '../../components/shared/Badge.astro';
import MusicianCard from '../../components/home/MusicianCard.astro';
import { musicians } from '../../data/musicians';
---

<PageLayout
  title="Đội ngũ Nhạc công | Rainy Band"
  description="Đội ngũ nhạc công chuyên nghiệp của Rainy Band — guitar, keyboard, cajon, bass và nhiều hơn nữa, sẵn sàng cho mọi sân khấu sự kiện."
>
  <section class="w-full pt-16 pb-12 md:pt-24 md:pb-16 bg-neutral-bg">
    <Container>
      <div class="reveal">
        <Badge label="NHẠC CÔNG" tone="dark" class="mb-4" />
      </div>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-display font-bold text-brand-900 tracking-tight mb-6 reveal" data-delay="100">
        Đội ngũ nhạc công Rainy Band
      </h1>
      <p class="text-base md:text-xl text-neutral-muted leading-relaxed max-w-3xl reveal" data-delay="200">
        Những nhạc công chuyên nghiệp, đa năng và giàu kinh nghiệm biểu diễn sân khấu lẫn phòng thu.
      </p>
    </Container>
  </section>

  <section class="w-full py-12 md:py-20 bg-neutral-bg">
    <Container>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {musicians.map((musician, index) => (
          <div class="reveal" data-delay={Math.min(index * 100, 500)}>
            <MusicianCard {...musician} class="w-full" />
          </div>
        ))}
      </div>
    </Container>
  </section>
</PageLayout>
