---
import Badge from '../shared/Badge.astro';
import type { CoreTeamMember } from '../../data/coreTeam';

interface Props extends CoreTeamMember {}

const { slug, name, roleLabel, bio, images, class: className } = Astro.props;

const rootClasses = className ?? 'block flex flex-col group no-underline text-inherit';
---

<a href={`/doi-ngu/${slug}`} class={rootClasses}>
  <div class="relative w-full aspect-[4/5] bg-neutral-bg rounded-3xl mb-4 shadow-sm hover-media-container cursor-pointer block overflow-hidden">
    <!-- TODO: thay bằng ảnh thật của Founder/Manager -->
    <img 
      src={images[0]} 
      alt={name} 
      class="absolute inset-0 w-full h-full object-contain"
    />
    <div class="absolute inset-x-0 bottom-0 h-[30%] bg-gradient-to-t from-brand-950/70 to-transparent z-10 pointer-events-none"></div>
    <div class="hover-media-overlay z-10"></div>
    
    <div class="absolute inset-0 p-5 flex flex-col justify-between z-20">
      <div class="flex">
        <Badge label={roleLabel} tone="light" />
      </div>
      
      <div class="mt-auto">
        <!-- TODO: cập nhật tên thật của Founder/Manager -->
        <h3 class="font-display text-3xl font-bold text-white tracking-tight">{name}</h3>
      </div>
    </div>
  </div>
  
  <p class="text-sm text-neutral-muted leading-relaxed px-1">
    <!-- TODO: cập nhật bio thật nếu cần -->
    {bio}
  </p>
</a>
