---
import Badge from '../shared/Badge.astro';
import type { CoreTeamMember } from '../../data/coreTeam';

// Fix lỗi "Property 'class' does not exist on type 'Props'":
// CoreTeamMember không khai báo field `class`, nên cần thêm thủ công ở đây.
interface Props extends CoreTeamMember {
  class?: string;
}

const { slug, name, roleLabel, bio, images, class: className } = Astro.props;

const rootClasses = className ?? 'block flex flex-col group no-underline text-inherit';
---

<a
  href={`/doi-ngu/${slug}`}
  class={[
    rootClasses,
    'rounded-3xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-bg',
  ].join(' ')}
>
  <div class="relative w-full aspect-[4/5] bg-neutral-bg rounded-3xl mb-4 shadow-sm border border-neutral-text/[0.06] hover-media-container cursor-pointer block overflow-hidden transition-shadow duration-500 group-hover:shadow-xl group-hover:shadow-brand-900/15">
    <!-- TODO: thay bằng ảnh thật của Founder/Manager -->
    <img
      src={images[0]}
      alt={name}
      class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      loading="lazy"
    />
    <div class="absolute inset-x-0 bottom-0 h-[55%] bg-gradient-to-t from-brand-950/85 via-brand-950/25 to-transparent z-10 pointer-events-none"></div>
    <div class="hover-media-overlay z-10"></div>

    <div class="absolute inset-0 p-5 flex flex-col justify-between z-20">
      <div class="flex">
        <Badge label={roleLabel} tone="light" />
      </div>

      <div class="mt-auto">
        <!-- TODO: cập nhật tên thật của Founder/Manager -->
        <h3 class="font-display text-2xl md:text-3xl font-bold text-white tracking-tight leading-tight drop-shadow-sm">
          {name}
        </h3>
      </div>
    </div>
  </div>

  {bio && (
    <p class="text-sm text-neutral-muted leading-relaxed px-1 line-clamp-2 transition-colors duration-300 group-hover:text-neutral-text">
      <!-- TODO: cập nhật bio thật nếu cần -->
      {bio}
    </p>
  )}
</a>