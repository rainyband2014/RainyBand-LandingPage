---
import Badge from '../shared/Badge.astro';
import type { CoreTeamMember } from '../../data/coreTeam';

interface Props extends CoreTeamMember {}

const { name, roleLabel, bio, imageUrl } = Astro.props;
---

<div class="flex flex-col group">
  <div class="relative w-full aspect-[4/5] rounded-3xl overflow-hidden mb-4 shadow-sm">
    <!-- TODO: thay bằng ảnh thật của Founder/Manager -->
    <img 
      src={imageUrl} 
      alt={name} 
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-x-0 bottom-0 h-[30%] bg-gradient-to-t from-brand-950/70 to-transparent"></div>
    
    <div class="absolute inset-0 p-5 flex flex-col justify-between">
      <div class="flex">
        <Badge label={roleLabel} tone="light" />
      </div>
      
      <div class="mt-auto">
        {/* TODO: cập nhật tên thật của Founder/Manager */}
        <h3 class="font-display text-3xl font-bold text-white tracking-tight">{name}</h3>
      </div>
    </div>
  </div>
  
  <p class="text-sm text-neutral-muted leading-relaxed px-1">
    <!-- TODO: cập nhật bio thật nếu cần -->
    {bio}
  </p>
</div>
