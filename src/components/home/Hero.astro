---
import Container from '../shared/Container.astro';
import Button from '../shared/Button.astro';
import Badge from '../shared/Badge.astro';

const socialLinks = [
  { label: 'YouTube', href: '#' },
  { label: 'TikTok', href: '#' },
  { label: 'Facebook', href: '#' },
  { label: 'Instagram', href: '#' },
];
---

<section class="w-full py-6 md:py-10">
  <Container>
    <div class="relative w-full min-h-[85vh] md:min-h-[80vh] rounded-3xl overflow-hidden group flex flex-col justify-end">
      <!-- Background Image -->
      <!-- TODO: thay ảnh placeholder này bằng ảnh hero thật (đã bỏ text placeholder) -->
      <img 
        src="https://placehold.co/1600x1000/0a1720/0a1720" 
        alt="Rainy Band Hero" 
        class="absolute inset-0 w-full h-full object-cover"
      />

      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-950/80 to-transparent"></div>

      <!-- Content -->
      <div class="relative z-10 p-6 md:p-12 lg:p-16 flex flex-col items-start w-full max-w-4xl pt-20">
        <div class="reveal">
          <Badge label="RAINY BAND" tone="light" class="mb-6 md:mb-8" />
        </div>
        
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-snug md:leading-snug mb-4 md:mb-6 reveal" data-delay="100">
          Âm nhạc chuyên nghiệp – Cảm xúc trọn vẹn cho mọi sự kiện
        </h1>
        
        <p class="text-brand-100/90 text-base md:text-xl lg:text-2xl mb-6 md:mb-8 max-w-3xl leading-relaxed reveal" data-delay="200">
          Từ những buổi tiệc riêng tư ấm cúng đến các sân khấu sự kiện sôi động, Rainy Band mang đến những màn trình diễn được đầu tư chỉn chu, phù hợp với không gian, đối tượng khách mời và tinh thần riêng của từng chương trình.
        </p>

        <div class="flex flex-wrap gap-3 mb-8 md:mb-10 text-xs md:text-sm font-medium text-white/80 reveal" data-delay="300">
          <span class="px-3 py-1 bg-white/10 rounded-full backdrop-blur-sm border border-white/5">Acoustic Band</span>
          <span class="px-3 py-1 bg-white/10 rounded-full backdrop-blur-sm border border-white/5">Electric Band</span>
          <span class="px-3 py-1 bg-white/10 rounded-full backdrop-blur-sm border border-white/5">Ca sĩ biểu diễn</span>
          <span class="px-3 py-1 bg-white/10 rounded-full backdrop-blur-sm border border-white/5">Âm nhạc sự kiện</span>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 mb-10 md:mb-16 w-full sm:w-auto reveal" data-delay="400">
          <Button href="/#booking" variant="primary" size="lg" class="w-full sm:w-auto hover:scale-[1.02] active:scale-[0.98]">
            Tư vấn và đặt lịch biểu diễn
          </Button>
          <Button href="#media" variant="ghost" size="lg" class="w-full sm:w-auto hover:scale-[1.02] active:scale-[0.98]">
            Xem các màn trình diễn
          </Button>
        </div>

        <!-- Social Links -->
        <div class="flex flex-wrap gap-6 mt-6 md:mt-8 text-sm md:text-base font-medium">
          {socialLinks.map(link => (
            <a href={link.href} class="text-brand-100/70 hover:text-white transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>