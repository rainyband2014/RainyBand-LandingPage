---
import Badge from '../shared/Badge.astro';
import type { Musician } from '../../data/musicians';

interface Props extends Musician {
  class?: string;
}

const { slug, name, instrument, instrumentGroup, experienceYears, imageUrl, class: className } = Astro.props;

const rootClasses = className ?? 'w-64 flex-shrink-0 snap-start';
---

<a href={`/nhac-cong/${slug}`} class={`${rootClasses} flex flex-col group cursor-pointer no-underline text-inherit`}>
  <div class="relative w-full aspect-[4/5] bg-neutral-bg rounded-2xl mb-4 shadow-sm hover-media-container block cursor-pointer overflow-hidden">
    <!-- TODO: thay bằng ảnh thật của nhạc công -->
    <img 
      src={imageUrl} 
      alt={name} 
      class="absolute inset-0 w-full h-full object-contain"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent z-10 pointer-events-none"></div>
    <div class="hover-media-overlay z-10"></div>
    
    <div class="absolute inset-0 p-4 flex flex-col items-center justify-end z-20">
      <p class="text-white/90 text-[10px] font-bold tracking-widest uppercase mb-auto bg-black/25 px-2 py-1 rounded-md backdrop-blur-sm border border-white/10">
        {experienceYears} NĂM KINH NGHIỆM
      </p>
      
      <h3 class="font-display text-3xl md:text-4xl font-bold text-white uppercase text-center mb-2 drop-shadow-md tracking-tight leading-none">
        <!-- TODO: cập nhật tên nhạc công thật -->
        {name}
      </h3>
    </div>
  </div>
  
  <div class="flex flex-col items-start px-1">
    <Badge label={instrumentGroup} tone="dark" class="mb-2 scale-90 origin-left" />
    <p class="text-base font-bold text-neutral-text">{instrument}</p>
  </div>
</a>
