---
import Container from '../shared/Container.astro';

// Array of 6 placeholders
const logos = Array.from({ length: 6 }, (_, i) => ({
  id: i + 1,
  url: "https://placehold.co/120x48/e5e5e5/999999?text=Logo",
  alt: `Client Logo ${i + 1}`
}));
---

<section class="w-full py-12 md:py-16 bg-neutral-bg">
  <Container>
    <h2 class="text-center text-sm font-medium text-neutral-muted mb-8">
      Đối tác đã đồng hành cùng Rainy Band
    </h2>
    
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
      {logos.map(logo => (
        <div class="flex items-center justify-center">
          <!-- TODO: thay bằng logo SVG/PNG thật của từng đối tác, kèm alt text mô tả tên đối tác -->
          <img 
            src={logo.url} 
            alt={logo.alt} 
            class="opacity-60 hover:opacity-100 transition-opacity duration-300 object-contain w-[120px] h-[48px]"
          />
        </div>
      ))}
    </div>
  </Container>
</section>
