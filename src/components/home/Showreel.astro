---
import Container from '../shared/Container.astro';
import Badge from '../shared/Badge.astro';
import ShowreelCard from './ShowreelCard.astro';

const cards = [
  {
    label: "Không gian nhỏ",
    title: "Café, Rooftop, Bar",
    description: "Set nhạc phù hợp không gian quán, đa dạng thể loại"
  },
  {
    label: "Kỷ niệm riêng",
    title: "Sinh nhật, Kỷ niệm",
    description: "Chọn lọc theo yêu cầu, phù hợp không khí buổi tiệc"
  },
  {
    label: "Sự kiện lớn",
    title: "Sự kiện, Khai trương",
    description: "Khuấy động không khí, song ngữ, theo kịch bản chương trình"
  },
  {
    label: "Ẩm thực",
    title: "Nhà hàng, Quán ăn",
    description: "Nhạc nền nhẹ nhàng, thư giãn và không ồn ào"
  }
];
---

<section class="w-full py-16 md:py-24 bg-neutral-surface">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 md:mb-14 gap-4">
      <div>
        <Badge label="SHOWREEL" tone="dark" class="mb-4" />
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-brand-900 tracking-tight">
          Rainy Band diễn ở đâu?
        </h2>
      </div>
      <a href="#media" class="text-neutral-muted hover:text-brand-600 hover:underline text-sm font-medium transition-colors mb-1 md:mb-2">
        Xem tất cả media &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {cards.map(card => (
        <ShowreelCard 
          label={card.label}
          title={card.title}
          description={card.description}
        />
      ))}
    </div>
  </Container>
</section>
