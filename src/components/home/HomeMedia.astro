---
import Container from '../shared/Container.astro';
import Badge from '../shared/Badge.astro';
import Button from '../shared/Button.astro';
import HomeMediaCarousel from './HomeMediaCarousel';
---

<section id="media" class="w-full py-16 md:py-24 bg-neutral-bg">
  <Container>
    <div class="mb-10 md:mb-14 reveal">
      <Badge label="MEDIA" tone="dark" class="mb-4" />
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-brand-900 tracking-tight mb-6">
        Cùng xem Rainy Band trên sân khấu
      </h2>
      <div class="max-w-3xl space-y-4 text-base md:text-lg text-neutral-muted leading-relaxed mb-8">
        <p>
          Mỗi video là một phần không khí mà Rainy Band đã cùng khách hàng và khán giả tạo nên.
        </p>
        <p>
          Từ những bản acoustic nhẹ nhàng đến các tiết mục full band sôi động, Rainy Band luôn cố gắng mang đến sự kết nối chân thật giữa nghệ sĩ, âm nhạc và người nghe.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4">
        <Button href="/showcase" variant="primary">
          Xem thêm video biểu diễn
        </Button>
        <Button href="#" variant="ghost" class="bg-brand-50 text-brand-600 hover:bg-brand-100 hover:text-brand-700">
          Theo dõi Rainy Band trên Facebook
        </Button>
      </div>
    </div>

    <div class="reveal" data-delay="200">
      <HomeMediaCarousel client:visible />
    </div>
  </Container>
</section>
