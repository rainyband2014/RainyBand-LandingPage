---
import Container from '../shared/Container.astro';
import BookingForm from './BookingForm';

const contactButtons = [
  { label: 'Gọi', href: '#' },
  { label: 'Zalo', href: '#' },
  { label: 'Email', href: '#' },
  { label: 'Book Âm thanh', href: '#' },
];
---

<section id="booking" class="w-full py-16 md:py-24 bg-brand-950 rounded-t-3xl md:rounded-t-[3rem] mt-8">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
      <!-- Left Column -->
      <div class="flex flex-col">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-white mb-6 leading-tight">
          Để lại thông tin để Rainy Band tư vấn và báo giá phù hợp
        </h2>
        <p class="text-base md:text-lg text-white/70 mb-10 leading-relaxed max-w-lg">
          Điền ngắn gọn loại show, ngày dự kiến, địa điểm và mood mong muốn, đội ngũ sẽ liên hệ tư vấn trong thời gian sớm nhất.
        </p>

        <!-- TODO: thay href thật cho các kênh liên hệ -->
        <div class="flex flex-wrap gap-3">
          {contactButtons.map(btn => (
            <a 
              href={btn.href} 
              class="inline-flex items-center justify-center px-5 py-2.5 bg-transparent border border-white/30 hover:border-white hover:bg-white/10 text-white text-sm font-medium rounded-full transition-colors"
            >
              {btn.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Right Column -->
      <div class="bg-neutral-surface rounded-3xl p-6 md:p-8 lg:p-10 shadow-xl">
        <BookingForm client:visible />
      </div>
    </div>
  </Container>
</section>
