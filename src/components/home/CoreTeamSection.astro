---
import Container from '../shared/Container.astro';
import Badge from '../shared/Badge.astro';
import CoreTeam from './CoreTeam.astro';
import { vocalists } from '../../data/vocalists';
import { musicians } from '../../data/musicians';

function truncate(text: string, maxLength = 50): string {
  const clean = text.split('\n')[0];
  if (clean.length <= maxLength) return clean;
  const cut = clean.slice(0, maxLength);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
}

const displayedVocalists = vocalists
  .filter(v => ['tra-my', 'dai-duong', 'linh-chi'].includes(v.slug))
  .sort((a, b) => ['tra-my', 'dai-duong', 'linh-chi'].indexOf(a.slug) - ['tra-my', 'dai-duong', 'linh-chi'].indexOf(b.slug));

const displayedMusicians = musicians
  .filter(m => ['lu-thien', 'truong-zang', 'nguyen-loc'].includes(m.slug))
  .sort((a, b) => ['lu-thien', 'truong-zang', 'nguyen-loc'].indexOf(a.slug) - ['lu-thien', 'truong-zang', 'nguyen-loc'].indexOf(b.slug));
---

<section class="w-full py-16 md:py-24 bg-neutral-bg border-t border-neutral-text/10">
  <Container>
    <div class="mb-12 md:mb-16 reveal">
      <Badge label="ĐỘI NGŨ NGHỆ SĨ" tone="dark" class="mb-4" />
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-brand-900 tracking-tight mb-6">
        Những người tạo nên màu sắc của Rainy Band
      </h2>
      <div class="max-w-3xl space-y-4 text-base md:text-lg text-neutral-muted leading-relaxed">
        <p>
          Rainy Band là tập hợp của các ca sĩ, nhạc công và nghệ sĩ biểu diễn có kinh nghiệm, cùng chung niềm đam mê với âm nhạc và sân khấu.
        </p>
        <p>
          Mỗi thành viên đều sở hữu thế mạnh riêng, từ giọng hát, khả năng trình diễn đến kỹ năng phối hợp trong ban nhạc. Sự kết hợp giữa các cá tính âm nhạc giúp Rainy Band có thể linh hoạt biến hóa theo nhiều phong cách chương trình khác nhau.
        </p>
      </div>
    </div>

    <CoreTeam />

    <div class="mt-20 pt-16 border-t border-neutral-text/10">
      <h3 class="text-2xl md:text-3xl font-display font-bold text-brand-900 tracking-tight mb-10 reveal">
        Thành viên nổi bật
      </h3>
      
      <!-- Vùng Vocal -->
      <div class="mb-6 reveal">
        <h4 class="uppercase text-sm font-bold tracking-wider text-brand-600">Vocal</h4>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8">
        {displayedVocalists.map((vocalist, index) => (
          <a href={`/vocal/${vocalist.slug}`} class="block group no-underline text-inherit reveal" data-delay={index * 100}>
            <div class="bg-white rounded-3xl shadow-sm border border-neutral-text/5 flex flex-col overflow-hidden h-full hover:shadow-md transition-shadow">
              <div class="aspect-square w-full overflow-hidden relative">
                <img
                  src={vocalist.posterImageUrl}
                  alt={vocalist.name}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="p-5 flex flex-col flex-grow">
                <Badge label={vocalist.badgeLabel} tone="dark" class="self-start mb-3 scale-90 origin-left" />
                <h4 class="text-lg font-bold font-display text-brand-900 mb-1 group-hover:text-brand-600 transition-colors">
                  {vocalist.name}
                </h4>
                <p class="text-[13px] font-medium text-brand-600 mb-3 line-clamp-1">
                  {vocalist.genres}
                </p>
                <p class="text-sm text-neutral-text leading-relaxed">
                  {truncate(vocalist.fullBio)}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Vùng Nhạc công -->
      <div class="mt-12 md:mt-16 pt-12 border-t border-neutral-text/10 mb-6 reveal">
        <h4 class="uppercase text-sm font-bold tracking-wider text-brand-600">Nhạc công</h4>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8">
        {displayedMusicians.map((musician, index) => (
          <a href={`/nhac-cong/${musician.slug}`} class="block group no-underline text-inherit reveal" data-delay={index * 100}>
            <div class="bg-white rounded-3xl shadow-sm border border-neutral-text/5 flex flex-col overflow-hidden h-full hover:shadow-md transition-shadow">
              <div class="aspect-square w-full overflow-hidden relative">
                <img
                  src={musician.imageUrl}
                  alt={musician.name}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="p-5 flex flex-col flex-grow">
                <Badge label={musician.instrumentGroup} tone="dark" class="self-start mb-3 scale-90 origin-left" />
                <h4 class="text-lg font-bold font-display text-brand-900 mb-1 group-hover:text-brand-600 transition-colors">
                  {musician.name}
                </h4>
                <p class="text-[13px] font-medium text-brand-600 mb-3 line-clamp-1">
                  {musician.bio}
                </p>
                <p class="text-sm text-neutral-text leading-relaxed">
                  {truncate(musician.fullBio)}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </Container>
</section>