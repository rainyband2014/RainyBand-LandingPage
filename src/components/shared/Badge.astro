---
interface Props {
  label: string;
  tone?: 'dark' | 'light';
  class?: string;
}

const { label, tone = 'dark', class: className = '' } = Astro.props;

const toneStyles = {
  dark: "bg-brand-600 text-white",
  light: "bg-white/10 text-white backdrop-blur-sm",
};
---

<span class={`inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full ${toneStyles[tone]} ${className}`}>
  {label}
</span>
