---
import Badge from '../shared/Badge.astro';
import type { Vocalist } from '../../data/vocalists';

interface Props extends Vocalist {
  class?: string;
}

const { slug, name, badgeLabel, experienceYears, posterImageUrl, class: className } = Astro.props;

const rootClasses = className ?? 'w-full';
---

<a href={`/vocal/${slug}`} class={`${rootClasses} block group no-underline text-inherit`}>
  <div class="relative w-full aspect-[3/4] rounded-2xl overflow-hidden shadow-sm">
    <!-- TODO: thay bằng ảnh vocalist thật -->
    <img 
      src={posterImageUrl} 
      alt={name} 
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-x-0 bottom-0 h-[45%] bg-gradient-to-t from-brand-950/85 to-transparent"></div>
    
    <div class="absolute inset-0 p-5 flex flex-col justify-between">
      <div class="flex">
        <Badge label={badgeLabel} tone="light" />
      </div>
      
      <div class="mt-auto">
        <p class="text-white/70 text-[10px] md:text-xs font-bold tracking-widest uppercase mb-2">
          {experienceYears} NĂM KINH NGHIỆM
        </p>
        <h3 class="font-display text-2xl md:text-3xl font-bold text-white tracking-tight">
          {name}
        </h3>
      </div>
    </div>
  </div>
</a>
