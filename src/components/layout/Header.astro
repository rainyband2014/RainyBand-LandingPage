---
import Container from '../shared/Container.astro';
import Button from '../shared/Button.astro';
import MobileMenu from '../MobileMenu';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Giới thiệu', href: '/gioi-thieu' },
  { label: 'Đội ngũ', href: '/doi-ngu' },
  { label: 'Vocal', href: '/vocal' },
  { label: 'Nhạc công', href: '/nhac-cong' },
  { label: 'Dịch vụ', href: '/dich-vu' },
  { label: 'Showcase', href: '/showcase' },
  { label: 'Liên hệ', href: '/lien-he' },
];
---

<header class="sticky top-0 z-50 bg-neutral-surface border-b border-neutral-bg w-full">
  <Container class="flex items-center justify-between h-20">
    <!-- Logo -->
    <a href="/" class="text-2xl font-bold font-display text-brand-900 tracking-tight">
      Rainy Band
      <!-- TODO: thay bằng <img> logo SVG sau -->
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center space-x-1">
      {navItems.map(item => {
        const isActive = item.href !== '#' && currentPath.startsWith(item.href);
        return (
        <a 
          href={item.href} 
          class={`px-4 py-2 text-sm font-medium rounded-full transition-colors ${
            isActive 
              ? 'bg-brand-100 text-brand-800' 
              : 'text-neutral-text hover:text-brand-600 hover:bg-neutral-bg'
          }`}
        >
          {item.label}
        </a>
        );
      })}
    </nav>

    <!-- Right Side (CTA + Mobile Toggle) -->
    <div class="flex items-center space-x-4">
      <Button href="/#booking" variant="primary" class="hidden md:inline-flex">
        Đặt lịch ngay
      </Button>

      <!-- Mobile Menu (React Island) -->
      <MobileMenu navItems={navItems} currentPath={currentPath} client:load />
    </div>
  </Container>
</header>
