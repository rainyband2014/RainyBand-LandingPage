---
import Container from '../shared/Container.astro';

const currentYear = new Date().getFullYear();

const socialLinks = [
  { label: 'YouTube', href: '#' },
  { label: 'TikTok', href: '#' },
  { label: 'Facebook', href: '#' },
  { label: 'Instagram', href: '#' },
];
---

<footer class="w-full pt-16 pb-8 bg-neutral-surface border-t border-neutral-text/10">
  <Container>
    <div class="flex flex-col md:flex-row justify-between gap-10 mb-12">
      <!-- Left Column -->
      <div class="flex flex-col max-w-md">
        <a href="/" class="text-2xl font-bold font-display text-brand-900 tracking-tight mb-2 inline-block uppercase">
          RAINY BAND
        </a>
        <p class="text-xs font-medium text-brand-600 uppercase tracking-wider mb-4">
          Acoustic Band | Electric Band | Singer | Event Music
        </p>
        <p class="text-sm md:text-base text-neutral-muted leading-relaxed mb-6">
          Âm nhạc chuyên nghiệp cho sự kiện doanh nghiệp, private event, tiệc cưới, nhà hàng và cafe acoustic.
        </p>
        <div>
          <p class="text-xs font-bold text-neutral-muted uppercase tracking-wider mb-1">Hotline</p>
          <a href="tel:0332552700" class="text-lg font-medium text-brand-900 hover:text-brand-600 transition-colors">
            0332 552 700
          </a>
        </div>
      </div>

      <!-- Right Column -->
      <div class="flex flex-col items-start md:items-end">
        <!-- Social links -->
        <!-- TODO: thay href thật -->
        <div class="flex flex-wrap gap-4 md:gap-6 mb-6">
          {socialLinks.map(link => (
            <a href={link.href} class="text-sm font-medium text-neutral-muted hover:text-brand-600 transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="w-full text-center md:text-left border-t border-neutral-text/10 pt-8">
      <p class="text-xs text-neutral-muted">
        © {currentYear} Rainy Band. All rights reserved.
      </p>
    </div>
  </Container>
</footer>
