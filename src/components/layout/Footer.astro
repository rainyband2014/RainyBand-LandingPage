const quickLinks = [
  { label: "Giới thiệu", href: "#" },
  { label: "Đội ngũ", href: "#" },
  { label: "Dịch vụ", href: "#" },
  { label: "Showcase", href: "#" },
  { label: "Liên hệ", href: "#" },
];
---

<footer
  class="w-full border-t border-neutral-text/10 bg-neutral-surface pt-16 pb-8"
>
  <Container>
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-y-10 gap-x-16 mb-14"
    >
      <!-- BRAND -->
      <div class="md:col-span-5">
        <a
          href="/"
          class="inline-flex items-center gap-4 mb-5"
        >
          <img
            src="/images/logos/logo.svg"
            alt="Rainy Band"
            class="h-12 w-auto"
          />

          <span
            class="text-3xl font-bold uppercase tracking-tight text-brand-900"
          >
            Rainy Band
          </span>
        </a>

        <p
          class="uppercase tracking-widest text-xs font-semibold text-brand-600 mb-4"
        >
          Acoustic Band • Electric Band • Singer
          • Event Music
        </p>

        <p
          class="text-neutral-muted leading-7 max-w-md mb-7"
        >
          Âm nhạc chuyên nghiệp cho sự kiện
          doanh nghiệp, private event, tiệc
          cưới, nhà hàng và cafe acoustic.
        </p>

        <div>
          <div
            class="uppercase text-xs font-bold tracking-widest text-neutral-muted mb-2"
          >
            Hotline
          </div>

          <a
            href="tel:0332552700"
            class="inline-flex items-center gap-3 text-lg font-semibold hover:text-brand-600 transition-colors"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"
              ></path>
            </svg>

            0332 552 700
          </a>
        </div>
      </div>

      <!-- QUICK LINKS -->
      <div class="md:col-span-3 md:col-start-6">
        <h3
          class="uppercase text-xs font-bold tracking-widest mb-5"
        >
          Liên kết nhanh
        </h3>

        <nav class="flex flex-col gap-4">
          {
            quickLinks.map((link) => (
              <a
                href={link.href}
                class="text-neutral-muted hover:text-brand-600 transition-colors w-fit"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- SOCIAL -->
      <div
        class="md:col-span-4 flex flex-col items-start md:items-end"
      >
        <h3
          class="uppercase text-xs font-bold tracking-widest mb-5"
        >
          Kết nối với chúng tôi
        </h3>

        <div class="flex gap-4 flex-wrap">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                title={link.label}
                aria-label={link.label}
                class="group flex items-center justify-center
                     w-12 h-12 rounded-full
                     border border-neutral-text/10
                     bg-white
                     shadow-sm
                     hover:bg-brand-600
                     hover:-translate-y-1
                     hover:shadow-lg
                     transition-all duration-300"
              >
                <svg
                  class="w-6 h-6 group-hover:text-white"
                  style={`color:${link.color}`}
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d={link.icon} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="border-t border-neutral-text/10 pt-6 flex flex-col md:flex-row justify-between items-center gap-2"
    >
      <p class="text-xs text-neutral-muted">
        © {currentYear} Rainy Band. All rights reserved.
      </p>

      <p class="text-xs text-neutral-muted">
        Thiết kế & phát triển bởi
        <span
          class="text-brand-600 font-semibold ml-1"
        >
          Rainy Band
        </span>
      </p>
    </div>
  </Container>
</footer>
