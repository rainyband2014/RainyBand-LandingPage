    color: "#000000",
    icon: "M16.6 5.82c-.983-.985-1.53-2.32-1.53-3.72h-3.1v13.62a2.86 2.86 0 0 1-2.86 2.76 2.86 2.86 0 0 1-2.86-2.86 2.86 2.86 0 0 1 2.86-2.86c.28 0 .55.04.8.12v-3.15a6.03 6.03 0 0 0-.8-.05A5.96 5.96 0 0 0 3.15 15.68 5.96 5.96 0 0 0 9.11 21.6a5.96 5.96 0 0 0 5.96-5.96V9.05a7.63 7.63 0 0 0 4.46 1.43V7.38a4.72 4.72 0 0 1-2.93-1.56Z",
  },
  {
