---
import type { Service } from '../../data/services';

interface Props extends Service {}

const { slug, title, intro, imageUrl } = Astro.props;
---

<a href={`/dich-vu/${slug}`} class="block group no-underline text-inherit">
  <div class="relative w-full aspect-video rounded-2xl mb-4 shadow-sm hover-media-container cursor-pointer block">
    <!-- TODO: thay bằng ảnh dịch vụ thật -->
    <img 
      src={imageUrl} 
      alt={title} 
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="hover-media-overlay z-10"></div>
  </div>
  
  <h3 class="text-xl font-display font-bold text-brand-900 mb-2 group-hover:text-brand-600 transition-colors">
    {title}
  </h3>
  <p class="text-sm md:text-base text-neutral-muted leading-relaxed line-clamp-2">
    {intro}
  </p>
</a>
